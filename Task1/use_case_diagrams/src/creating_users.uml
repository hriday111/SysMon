@startuml
left to right direction

actor "Admin (Tier 1)" as Admin

rectangle "SysMon - Authentication System & Frontend" {
    usecase "Open Users Panel" as UC1
    usecase "Add User" as UC2
    usecase "Enter Username,\nPassword and Tier" as UC3
    usecase "Commit Changes" as UC4
    usecase "Create User Account\nwith No Permissions" as UC5
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

UC2 ..> UC1 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>

@enduml

