@startuml

left to right direction

actor "Tier 1 Admin" as A1 #blue
actor "Tier 2 Admin" as A2 #red
actor "Tier 3 Admin" as A3 #green
actor "Ollama" as Ollama

rectangle "SysMon - LLM Orchestration & Frontend" {
    usecase "Ensure Ollama Runtime" as ENSURE
    usecase "Check Ollama Installed" as CHECK
    usecase "Install Ollama" as INSTALL
    usecase "Verify Ollama Ready" as VERIFY
    usecase "Show Install Failure" as FAIL
}

A1 --> ENSURE #line:blue;
A2 --> ENSURE #line:red;
A3 --> ENSURE #line:green;

ENSURE ..> CHECK : <<include>>
ENSURE ..> VERIFY : <<include>>

INSTALL ..> CHECK : <<extend>>
FAIL ..> INSTALL : <<extend>>

VERIFY --> Ollama
INSTALL --> Ollama

@enduml
