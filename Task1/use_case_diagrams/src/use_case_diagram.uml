@startuml
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "Domain Models" {
    class ContainerConfig {
        + imageRef : String
        + networks : List<String>
        + volumes : Map<String, String>
        + envVars : Map<String, String>
        + ports : List<String>
        + generateCompose() : String
    }

    class User {
        + id : UUID
        + username : String
        + passwordHash : String
        + adminTier : Integer
        + getPermissions() : List<Permission>
        + updateTier(newTier : Integer) : void
    }

    class ResourceGroup {
        + groupId : String
        + name : String
        + maxCpuCores : Float
        + maxMemoryGb : Float
        + allowGpu : Boolean
    }

    class StorageGroup {
        + groupId : String
        + name : String
        + hostPath : String
        + sizeQuotaGb : Float
        + enforceQuota() : void
    }

    class ComposeDeployment {
        + deploymentId : String
        + composeContent : String
        + engineType : EngineType
        + deploy() : void
        + teardown() : void
    }

    class Container {
        + containerId : String
        + name : String
        + engineType : EngineType
        + status : ContainerStatus
        + metrics : NodeMetrics
        + start() : void
        + stop() : void
        + delete() : void
        + fetchLogs() : String
    }

    class NodeMetrics <<Utility>> {
        + cpuUsage : Float
        + memoryUsage : Float
        + diskSpaceAvailable : Float
        + timestamp : DateTime
    }
}

package "Services" {
    class StorageService {
        + createStorageGroup(name : String, quotaGb : Float) : StorageGroup
        + getAvailablePath(group : StorageGroup) : String
    }

    class OrchestrationService {
        + deployFromCompose(composeContent : String, engine : EngineType) : void
        + createFromUIConfig(config : ContainerConfig) : void
        + syncContainers() : void
    }
}

' Layout aligned with SE1_Report1.pdf Figure 1
ContainerConfig -[hidden]right- User
ResourceGroup -[hidden]right- StorageGroup
StorageGroup -[hidden]right- ComposeDeployment
ComposeDeployment -[hidden]right- Container
StorageService -[hidden]right- OrchestrationService

ContainerConfig "*" -- "1" ResourceGroup : constrained by >
ContainerConfig "*" -- "1" StorageGroup : stores data in >
ContainerConfig ..> ComposeDeployment : generates >
User "1" -- "0..*" Container : manages >
Container *-- "1" NodeMetrics : tracks >
OrchestrationService ..> Container : controls >
@enduml
