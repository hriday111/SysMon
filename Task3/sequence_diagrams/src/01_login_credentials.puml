@startuml
 title SysMon - Login and credential verification
 actor Administrator as A
 participant "SysMon Frontend" as FE
 participant "Authentication System" as AUTH
 A -> FE: Enter username and password
 FE -> AUTH: POST /api/auth/login\n{username, password}
 AUTH -> AUTH: Validate account; verify password hash
 alt valid credentials
   AUTH --> FE: 200 OK\n{accessToken, expiresIn, user}
   FE --> A: Open dashboard
 else invalid credentials or disabled user
   AUTH --> FE: 401 INVALID_CREDENTIALS
   FE --> A: Show generic login error
 end
 opt Verify active session / load effective access
   FE -> AUTH: GET /api/auth/me\nAuthorization: Bearer accessToken
   alt token valid
     AUTH --> FE: 200 {id,username,adminTier,permissions}
   else token invalid / expired
     AUTH --> FE: 401 TOKEN_INVALID / TOKEN_EXPIRED
   end
 end
@enduml
