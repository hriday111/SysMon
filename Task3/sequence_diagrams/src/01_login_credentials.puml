@startuml
title SysMon - Login and Credential Verification

actor Administrator as A
participant "SysMon Frontend" as FE
participant "SysMon Authentication System" as AUTH

A -> FE : Enter username and password
FE -> AUTH : POST /v1/auth/login\n{username, password}
AUTH -> AUTH : Validate account; verify password hash

alt Valid credentials
  AUTH --> FE : 200 OK\n{accessToken, expiresIn,\nuser: {userId, username, tier, permissions}}
  FE --> A : Open dashboard
else Invalid credentials or disabled user
  AUTH --> FE : 401 Unauthorized\n{code, message}
  FE --> A : Show generic login error
end

opt Verify active session / load effective access
  FE -> AUTH : GET /v1/auth/me\nAuthorization: Bearer accessToken
  alt Token valid
    AUTH --> FE : 200 OK\n{userId, username, tier, permissions}
  else Token missing, invalid or expired
    AUTH --> FE : 401 Unauthorized\n{code, message}
  end
end

@enduml
