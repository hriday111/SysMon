@startuml
title SysMon - Create User

actor "Tier 1 Administrator" as A
participant "SysMon Frontend" as FE
participant "SysMon Authentication System" as AUTH

A -> FE : Enter username, password and tier
FE -> AUTH : POST /v1/users\nAuthorization: Bearer accessToken\n{username, password, tier}
AUTH -> AUTH : Validate token and Tier 1 role

alt Authorized and valid input
  AUTH -> AUTH : Hash password; create account\nInitialize permissions = []
  AUTH --> FE : 201 Created\nLocation: /v1/users/{userId}\n{userId, username, tier, status, permissions, createdAt}
  FE --> A : Display created account
else Token missing, invalid or expired
  AUTH --> FE : 401 Unauthorized\n{code, message}
else Caller is not a Tier 1 admin
  AUTH --> FE : 403 Forbidden\n{code, message}
else Data invalid (username, password or tier)
  AUTH --> FE : 422 Unprocessable Entity\n{code, field, message}
else Username already taken
  AUTH --> FE : 409 Conflict\n{code, message}
end

@enduml
